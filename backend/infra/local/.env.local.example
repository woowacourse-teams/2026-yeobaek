# backend/에서 infra/local/.env.local로 복사한 뒤 값을 입력한다.
# set -a; source infra/local/.env.local; set +a 로 같은 터미널에 export한다.
# 실제 값 파일 .env.local은 기존 .gitignore 규칙으로 제외된다.

# 실제 application.properties / FcmConfiguration이 사용하는 필수 환경변수
FIREBASE_PROJECT_ID=''
GOOGLE_APPLICATION_CREDENTIALS=''

# 정적 웹 클라이언트에 필요한 공개 설정 (서버 인증 정보가 아님)
# Firebase Console > 프로젝트 설정 > 일반 > 웹 앱 설정
FIREBASE_WEB_API_KEY=''
# 앱 별칭이 아닌 appId 전체 값. 형식: 1:프로젝트번호:web:문자열
FIREBASE_WEB_APP_ID=''
FIREBASE_MESSAGING_SENDER_ID=''
# 프로젝트 설정 > Cloud Messaging > Web Push 인증서 > 공개 키
FIREBASE_WEB_VAPID_KEY=''
