# Compose 치환용. 서버의 기존 값은 유지한다. 이 파일로 .env를 통째로 덮어쓰지 않는다.
DOCKERHUB_USERNAME=
DB_PASSWORD=
ADMIN_TOKEN=
# 기존 별도 DB URL이 있으면 그대로 유지한다.
YEOBAEK_DATABASE_URL=jdbc:mysql://mysql:3306/yeobaek
BOOK_COVER_S3_BUCKET=
BOOK_COVER_S3_REGION=ap-northeast-2
BOOK_COVER_PUBLIC_BASE_URL=
BOOK_COVER_S3_PREFIX=yeobaek
POSTHOG_ENABLED=false
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
# 기존 JVM 옵션에서 -javaagent 옵션만 제거한 값을 넣는다.
JAVA_TOOL_OPTIONS=

# Firebase Console의 프로젝트 ID. 서비스 계정에는 이 프로젝트의 FCM 발송 권한이 필요하다.
FIREBASE_PROJECT_ID=
# 호스트의 JSON 파일 절대 경로. JSON 본문을 환경변수에 넣지 않는다.
# 예: /home/ubuntu/yeobaek-dev/secrets/firebase-admin.json
FIREBASE_CREDENTIALS_FILE=
