# Collector 전용 환경 파일. 앱에는 전달하지 않는다.
# MySQL 모니터링 계정: otel_monitor
MYSQL_MONITOR_PASSWORD=

# yeobaek-dev 소스의 OTLP base URL (https://...; /v1/* 제외)과 source token.
BETTER_STACK_APP_OTLP_ENDPOINT=
BETTER_STACK_APP_SOURCE_TOKEN=

# infra-dev 소스의 OTLP base URL (https://...; /v1/* 제외)과 source token.
BETTER_STACK_INFRA_OTLP_ENDPOINT=
BETTER_STACK_INFRA_SOURCE_TOKEN=
