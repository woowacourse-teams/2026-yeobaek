# Compose 치환용. 기존 서버의 .env를 이 예시로 통째로 덮어쓰지 않는다.
DOCKERHUB_USERNAME=
DB_PASSWORD=
ADMIN_TOKEN=

BOOK_COVER_S3_BUCKET=
BOOK_COVER_S3_REGION=ap-northeast-2
BOOK_COVER_PUBLIC_BASE_URL=
BOOK_COVER_S3_PREFIX=yeobaek

POSTHOG_ENABLED=false
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
JAVA_TOOL_OPTIONS=

# 운영 Firebase 프로젝트 ID 및 해당 프로젝트의 서비스 계정 JSON 파일 절대 경로.
FIREBASE_PROJECT_ID=
# 예: /home/ec2-user/yeobaek/secrets/firebase-admin.json
FIREBASE_CREDENTIALS_FILE=
