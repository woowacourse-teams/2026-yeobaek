<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!--
        CT_CONSTRUCTOR_THROW(생성자 예외로 인한 파이널라이저 공격 노출)를 도메인 엔티티 패키지
        (yeobaek.backend.*.domain)와 이동한 기존 대상 세 클래스에 한정해 제외한다.
        사유는 backend/docs/지침/검증/커밋_전_게이트.md의 "제외한 룰 기록"을 참고한다.
    -->
    <Match>
        <Package name="~yeobaek\.backend\..*\.domain"/>
        <Bug pattern="CT_CONSTRUCTOR_THROW"/>
    </Match>
    <!-- 기존 domain 패키지 제외 대상 중 통합 모델의 이름과 저장 패키지를 정리한 세 클래스. -->
    <Match>
        <Class name="yeobaek.backend.content.book.persistence.Book"/>
        <Bug pattern="CT_CONSTRUCTOR_THROW"/>
    </Match>
    <Match>
        <Class name="yeobaek.backend.space.club.persistence.Club"/>
        <Bug pattern="CT_CONSTRUCTOR_THROW"/>
    </Match>
    <Match>
        <Class name="yeobaek.backend.appreciation.comment.persistence.Comment"/>
        <Bug pattern="CT_CONSTRUCTOR_THROW"/>
    </Match>
    <!--
        AuthorBook과 Chapter는 같은 모듈의 Book 영속 엔티티 참조를 공유한다.
        방어적 복사는 JPA 식별성과 연관관계를 깨뜨리므로 두 생성자의 EI_EXPOSE_REP2만 제외한다.
    -->
    <Match>
        <Class name="yeobaek.backend.content.book.domain.AuthorBook"/>
        <Method name="&lt;init&gt;"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <Match>
        <Class name="yeobaek.backend.content.book.domain.Chapter"/>
        <Method name="&lt;init&gt;"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
    <!-- 공통 예외의 입력 검증을 유지하며 승인된 생성자 CT_CONSTRUCTOR_THROW만 제외한다. -->
    <Match>
        <Class name="yeobaek.backend.shared.exception.LogContextException"/>
        <Method name="&lt;init&gt;"/>
        <Bug pattern="CT_CONSTRUCTOR_THROW"/>
    </Match>
</FindBugsFilter>
